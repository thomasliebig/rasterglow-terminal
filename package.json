{
  "name": "@thomasliebig/rasterglow-terminal-vue",
  "version": "1.0.0",
  "description": "RasterGlow Terminal for the web: a Vue 3/WebGL CRT terminal renderer with ANSI, Unicode, scanlines and pixel-level phosphor afterglow.",
  "type": "module",
  "license": "MIT",
  "author": "Thomas Liebig",
  "repository": { "type": "git", "url": "git+https://github.com/thomasliebig/rasterglow-terminal.git" },
  "homepage": "https://thomasliebig.github.io/rasterglow-terminal/",
  "publishConfig": { "access": "public" },
  "keywords": ["terminal", "terminal-emulator", "vue", "vue3", "webgl", "crt", "retro", "ansi", "xterm", "phosphor", "afterglow", "windows", "conpty", "unicode"],
  "files": ["dist", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "main": "./dist/rasterglow-terminal.umd.cjs",
  "module": "./dist/rasterglow-terminal.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/rasterglow-terminal.js",
      "require": "./dist/rasterglow-terminal.umd.cjs"
    },
    "./style.css": "./dist/rasterglow-terminal.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.app.json --declaration --emitDeclarationOnly",
    "typecheck": "vue-tsc -b",
    "preview": "vite preview"
  },
  "dependencies": { "@xterm/headless": "^5.5.0" },
  "peerDependencies": { "vue": "^3.5.0" },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  }
}
