{
  "name": "rasterglow-terminal-windows",
  "version": "1.0.0",
  "private": true,
  "description": "RasterGlow Terminal for Windows with ConPTY and real phosphor persistence",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "@xterm/headless": "^5.5.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "de.thomasliebig.rasterglowterminal",
    "productName": "RasterGlow Terminal",
    "artifactName": "RasterGlow-Terminal-Windows-x64-Portable-v${version}.${ext}",
    "compression": "store",
    "asar": false,
    "npmRebuild": false,
    "files": [
      "main.js", "renderer.js", "index.html", "style.css", "retro-profile.ps1",
      "assets/**/*", "fonts/**/*", "package.json"
    ],
    "win": { "target": ["portable"], "signAndEditExecutable": false },
    "portable": { "artifactName": "RasterGlow-Terminal-Windows-x64-Portable-v${version}.${ext}" }
  }
}
